{
  "name": "dsh-ssh-view",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "SSH server view for the DeepSeek Harness Web UI: browse and edit files, inspect processes, and tail logs on a headless Linux server.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
